# NEXUS AI — Environment Configuration Template
NEXUS_ENV=development
NEXUS_DB_Path=./nexus_ai.db
NEXUS_DB_URL=postgresql://nexus:nexus_dev_password@localhost:5432/nexus_ai
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
NEXUS_JWT_SECRET=change-this-in-production-min-32-bytes-cryptographic-key
NEXUS_ACCESS_TOKEN_EXPIRE_MINUTES=60
NEXUS_REFRESH_TOKEN_EXPIRE_DAYS=14

# AI Provider Configuration (Google Gemini Primary, OpenAI Optional)
NEXUS_PRIMARY_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Reliability, RAG & Cost Controls
NEXUS_MAX_UPLOAD_BYTES=26214400
NEXUS_MAX_CONTEXT_TOKENS=6000
NEXUS_MAX_RESPONSE_TOKENS=2048
NEXUS_AGENT_MAX_STEPS=12
NEXUS_AGENT_MAX_TOOL_CALLS=6
NEXUS_RRF_K=60
